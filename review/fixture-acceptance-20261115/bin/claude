#!/usr/bin/python3
"""Acceptance-only launch budget; no retry may silently spend another call."""
import fcntl
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

REAL = "/home/zby/.local/bin/claude"
STATE = Path(__file__).resolve().parents[1] / "budget.json"
if sys.argv[1:] == ["--version"]:
    os.execv(REAL, [REAL, *sys.argv[1:]])
with STATE.open("r+") as handle:
    fcntl.flock(handle, fcntl.LOCK_EX)
    state = json.load(handle)
    allowed = state["used"] < state["limit"]
    state["events"].append({"at": datetime.now(timezone.utc).isoformat(),
                            "phase": state["phase"], "allowed": allowed, "pid": os.getpid()})
    if allowed:
        state["used"] += 1
    handle.seek(0)
    json.dump(state, handle, indent=2)
    handle.write("\n")
    handle.truncate()
    handle.flush()
    os.fsync(handle.fileno())
if not allowed:
    sys.stderr.write("Acceptance launch budget exhausted; no model was called.\n")
    sys.exit(78)
os.execv(REAL, [REAL, *sys.argv[1:]])
